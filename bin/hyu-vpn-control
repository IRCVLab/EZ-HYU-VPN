#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from hyu_vpn.control import VALID_COMMANDS, ControlProtocolError, send_control_command

DEFAULT_SOCKET = Path.home() / "Library" / "Application Support" / "hyu-openconnect" / "control.sock"


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="hyu-vpn-control")
    parser.add_argument("command", choices=sorted(VALID_COMMANDS))
    parser.add_argument("--socket", default=str(DEFAULT_SOCKET))
    args = parser.parse_args(argv)
    if args.socket != str(DEFAULT_SOCKET) and os.environ.get("HYU_VPN_CONTROL_ALLOW_SOCKET_OVERRIDE") != "1":
        print(json.dumps({"schema_version": 1, "ok": False, "error_code": "BAD_REQUEST"}, sort_keys=True))
        return 2
    try:
        response = send_control_command(args.socket, args.command)
    except (OSError, ControlProtocolError):
        print(json.dumps({"schema_version": 1, "ok": False, "error_code": "CONTROL_UNAVAILABLE"}, sort_keys=True))
        return 1
    print(json.dumps(response, sort_keys=True))
    return 0 if response.get("ok") is True else 1


if __name__ == "__main__":
    raise SystemExit(main())
