<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Quarantine template: inert by default so this tracked legacy plist cannot auto-connect. -->
  <key>Label</key>
  <string>local.hyu-openconnect</string>
  <key>Disabled</key>
  <true/>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/false</string>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
  <key>ThrottleInterval</key>
  <integer>120</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/shchoi/Library/Logs/hyu-openconnect-service.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/shchoi/Library/Logs/hyu-openconnect-service.err</string>
</dict>
</plist>
